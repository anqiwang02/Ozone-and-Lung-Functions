adjusted <- read_xlsx("/Users/anqiwang/Documents/GitHub/Ozone-and-Lung-Functions/primary genes/adjusted p values for secondary lung genes.xlsx")
View(adjusted)
min=0.05 #significance level
vn=expression(paste(-log[10],"(fully randomization-based adjusted ", italic(P), " values)"))
ti=expression(paste("adjusted Fisher-exact ", italic(P), " values of 704 CpG sites"))
volcano <- ggplot(data=adjusted, aes(x=mean_difference, y=-log10(adjusted_p_value))) + geom_point() + xlab("Average Causal Effects(ACE)") + ylab(vn) +
geom_hline(yintercept=-log10(min), col="red")+   geom_point(data = adjusted[which.min(adjusted$adjusted_p_value), ], color="red",
size=2)
#+ggtitle(ti)
volcano
